---
import '../styles/global.css';
const { title = 'OpenBot Monitor — Twój zespół, na Twoim biurku.', description = 'Wybierz czołówkę monitora ESP32 i podłącz go przez USB. Statusy Twoich agentów OpenBot na osobnym ekranie.' } = Astro.props;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#171719" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;550;600;650;700;750;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">Przejdź do treści</a>
    <header class="site-header wrap">
      <a href="/" class="brand" aria-label="OpenBot Monitor — strona główna">
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><i></i></span>
        <span>OpenBot <strong>Monitor</strong></span>
      </a>
      <nav class="pill-nav" aria-label="Menu główne">
        <a href="/#czolowki">Czołówki</a>
        <a href="/#jak-to-dziala">Jak to działa</a>
        <a href="/#sprzet">Sprzęt</a>
      </nav>
      <a class="button small primary header-cta" href="/instaluj/">Podłącz ESP32 <span class="usb-symbol" aria-hidden="true">↥</span></a>
    </header>
    <slot />
    <footer class="site-footer wrap">
      <a href="/" class="footer-name">OpenBot Monitor</a>
      <p>Niezależny projekt społecznościowy dla użytkowników OpenBota.</p>
      <a href="https://openbot.run/?ref=ru8v5jn8" target="_blank" rel="noopener noreferrer">Poznaj OpenBot</a>
    </footer>
    <script src="../scripts/screens.ts"></script>
  </body>
</html>
